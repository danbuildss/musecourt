{
  "name": "musecourt",
  "version": "0.1.0",
  "private": true,
  "description": "MuseCourt is a court system for autonomous agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test",
    "serve": "tsx scripts/serve.ts",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "simulate": "tsx scripts/simulate.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
