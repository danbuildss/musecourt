{
  "name": "musecourt",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "MuseCourt is a court system for autonomous agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test",
    "serve": "tsx scripts/serve.ts",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "simulate": "tsx scripts/simulate.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:museworld": "tsx scripts/smoke-museworld.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "satori": "0.56.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
