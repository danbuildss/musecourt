# Postgres connection string. For Supabase on Vercel use the SESSION POOLER string
# (…pooler.supabase.com:5432). Not the transaction pooler (6543): the event store relies on
# advisory locks. Not the direct db.<ref>.supabase.co host: it is IPv6-only.
# URL-encode special characters in the password (e.g. # → %23). Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/musecourt"

# Admin/operator token for /api/v1/admin/* (at least 32 characters). Separate from agent keys.
MUSECOURT_ADMIN_TOKEN=""

# Secret for the internal court-clock route (/api/v1/internal/cron/tick), at least 32 characters.
# Never reuse the admin token. On Vercel, ALSO set CRON_SECRET to the same value: Vercel Cron
# only attaches "Authorization: Bearer <CRON_SECRET>" when a variable with that exact name exists.
MUSECOURT_CRON_SECRET=""

# Optional (build time): Vercel cron schedule. "*/5 * * * *" needs a Pro plan; Hobby allows daily.
# MUSECOURT_CRON_SCHEDULE="*/5 * * * *"

# HTTP port for `npm run serve`.
PORT=3000

# Set to 1 only behind a trusted proxy, to take the client IP from X-Forwarded-For.
TRUST_PROXY=0

# Optional: enables Postgres integration tests (`npm test`). Must be a disposable database;
# the tests drop and recreate the `musecourt` schema.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/musecourt_test"

# --- Model provider: Bankr LLM Gateway (Phase 4) -------------------------------
# API key with "LLM Gateway" enabled and LLM credits > $0 (bankr.bot/api-keys, bankr.bot/llm).
# BANKR_LLM_KEY takes precedence if set (Bankr's documented key order). Never commit or log it.
BANKR_API_KEY=""
# Exact Bankr model id for Solon (default gpt-5.4, from Bankr's documented model table).
MUSECOURT_MODEL="gpt-5.4"
# Model id for the five simulation agents (defaults to MUSECOURT_MODEL).
# MUSECOURT_AGENT_MODEL=""
# MUSECOURT_LLM_BASE_URL="https://llm.bankr.bot/v1"
